# Node Environment
NODE_ENV=development
PORT=3021

# Plaid Configuration
# Get your credentials from https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox
# Optional: Specify products you want to use.
# Do NOT list `accounts` here — Plaid includes it automatically with
# `transactions`, and naming it explicitly fails with "invalid product names".
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Admin Authorization (TD-006)
# Comma-separated usernames that are auto-promoted to admin on their first hit
# to /api/v1/admin/*. The flag is then persisted on the User record, so later
# requests don't require this env var. Leave unset to require manual seeding
# via direct edit of users.json.
# Plaid webhooks (TD-021). Without this no Item registers a webhook, so nothing
# tells the app that new transactions exist, no consent-expiry warning arrives,
# and Item errors surface only when someone happens to sync. Must be publicly
# reachable over HTTPS — Plaid calls it, not the browser. The receiver verifies
# every request's ES256 signature, so exposing it is safe.
#   PLAID_WEBHOOK_URL=https://budget.jaredcarrano.com/api/v1/plaid/webhook
# Existing Items keep whatever webhook they were linked with; run
# `npx ts-node src/scripts/backfill-plaid-webhooks.ts` to point them here.

# ADMIN_USERNAMES — REMOVED 2026-09-08 (SA-10). This auto-promoted any user whose
# username appeared here to admin on their first admin request. Combined with open
# registration it was a privilege-escalation path: an unregistered name on the list
# was claimable by anyone. Grant admin by setting isAdmin: true on the stored user.
#
# Registration is invitation-only. It is allowed without a join code only when no
# users exist yet (first-run bootstrap). Set this to exactly "true" to reopen it for
# local development; anything else — including "1" and "yes" — leaves it closed.
# ALLOW_OPEN_REGISTRATION=true

# Encryption Configuration (must be separate from JWT_SECRET in production)
# Generate with: openssl rand -hex 32
PLAID_ENCRYPTION_SECRET=your_32_byte_hex_encryption_key_change_this_in_production

# Data Storage
DATA_DIR=./data

# Storage Configuration (filesystem or s3)
# For local development: filesystem
# For production: s3
STORAGE_TYPE=filesystem

# S3 Configuration (for production)
# S3_BUCKET_NAME=budget-app-data
# S3_PREFIX=data/
# AWS_REGION=us-east-1

# AWS Credentials for Production Data Sync
# Choose one of the following authentication methods:

# Method 1: AWS CLI Profile (Recommended)
# AWS_PROFILE=budget-app-prod

# Method 2: Direct Credentials (Alternative)
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# Method 3: Session Tokens (For temporary access)
# AWS_ACCESS_KEY_ID=ASIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...

# Production Data Sync Configuration
# PRODUCTION_S3_BUCKET_NAME=your-production-bucket-name
# PRODUCTION_S3_PREFIX=data/

# Off-bucket snapshot target for scripts/backup-prod-snapshot.sh (TD-019).
# Separate bucket from PRODUCTION_S3_BUCKET_NAME — versioning on the primary
# bucket protects against bad writes, not against losing the bucket itself.
# BACKUP_S3_BUCKET_NAME=budget-app-backup

# CORS Configuration (Frontend URL)
FRONTEND_URL=http://localhost:5183

# API Configuration
API_PREFIX=/api/v1

# Logging
LOG_LEVEL=debug

# GitHub Integration (for feedback feature)
# Create a GitHub Personal Access Token with repo scope
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_OWNER=JCarran0
GITHUB_REPO=household-budgeting

# AI Chatbot & Categorization
# Get your API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key
# Fine-grained GitHub PAT with issues:write scope for chatbot issue filing
GITHUB_ISSUES_PAT=your_github_issues_pat
# Monthly AI spending cap in dollars (default: 20)
CHATBOT_MONTHLY_LIMIT=20